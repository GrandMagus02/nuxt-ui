    <div data-slot="bar" class="flex items-center justify-between gap-2">
      <div data-slot="leading" class="flex items-center min-w-0 gap-1"><button type="button" data-slot="button" aria-label="Play" class="rounded-md font-medium inline-flex items-center disabled:cursor-not-allowed aria-disabled:cursor-not-allowed disabled:opacity-75 aria-disabled:opacity-75 transition-colors text-sm gap-1.5 outline-inverted/25 focus-visible:outline-3 hover:disabled:bg-transparent dark:hover:disabled:bg-transparent hover:aria-disabled:bg-transparent dark:hover:aria-disabled:bg-transparent p-1.5 text-white hover:bg-white/15 active:bg-white/15 focus-visible:bg-white/15 focus-visible:ring-white disabled:bg-transparent aria-pressed:bg-white/15"><span class="iconify i-lucide:play shrink-0 size-5" aria-hidden="true" data-slot="leadingIcon"></span>
