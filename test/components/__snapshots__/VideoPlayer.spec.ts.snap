exports[`VideoPlayer > renders with as correctly 1`] = `
"<section role="region" aria-label="Video player" data-state="paused" data-slot="root" class="group/video relative isolate overflow-hidden aspect-video bg-black text-white rounded-lg data-fullscreen:rounded-none data-idle:cursor-none"><video src="https://example.com/video.mp4" playsinline="" preload="metadata" tabindex="-1" data-slot="video" class="size-full object-contain outline-none"></video>
